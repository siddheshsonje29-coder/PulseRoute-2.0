<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>PulseRoute Emergency Portal</display-name>
    <description>PulseRoute Citizen Emergency Coordination System with Java Servlet Authentication</description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <name>JSESSIONID</name>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.pulseroute.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Signup Servlet -->
    <servlet>
        <servlet-name>SignupServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.SignupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SignupServlet</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Forgot Password Servlet -->
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <!-- Session Information Servlet -->
    <servlet>
        <servlet-name>SessionServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.SessionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SessionServlet</servlet-name>
        <url-pattern>/api/session</url-pattern>
    </servlet-mapping>

    <!-- Hospital Login Servlet -->
    <servlet>
        <servlet-name>HospitalLoginServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.HospitalLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalLoginServlet</servlet-name>
        <url-pattern>/hospital/login</url-pattern>
    </servlet-mapping>

    <!-- Hospital Logout Servlet -->
    <servlet>
        <servlet-name>HospitalLogoutServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.HospitalLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalLogoutServlet</servlet-name>
        <url-pattern>/hospital/logout</url-pattern>
    </servlet-mapping>

    <!-- Hospital Session Servlet -->
    <servlet>
        <servlet-name>HospitalSessionServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.HospitalSessionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalSessionServlet</servlet-name>
        <url-pattern>/hospital/session</url-pattern>
    </servlet-mapping>

    <!-- Hospital Ambulance Fleet Servlet -->
    <servlet>
        <servlet-name>HospitalAmbulanceServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.HospitalAmbulanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalAmbulanceServlet</servlet-name>
        <url-pattern>/hospital/ambulances</url-pattern>
        <url-pattern>/hospital/ambulances/add</url-pattern>
        <url-pattern>/hospital/ambulances/update</url-pattern>
        <url-pattern>/hospital/ambulances/authorize</url-pattern>
    </servlet-mapping>

    <!-- Hospital Emergency Management Servlet -->
    <servlet>
        <servlet-name>HospitalEmergencyServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.HospitalEmergencyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalEmergencyServlet</servlet-name>
        <url-pattern>/hospital/emergencies</url-pattern>
        <url-pattern>/hospital/emergency/approve</url-pattern>
        <url-pattern>/hospital/emergency/reject</url-pattern>
        <url-pattern>/hospital/emergency/assign</url-pattern>
        <url-pattern>/hospital/emergency/status-update</url-pattern>
    </servlet-mapping>

    <!-- Citizen Emergency SOS Servlet -->
    <servlet>
        <servlet-name>EmergencyServlet</servlet-name>
        <servlet-class>com.pulseroute.servlet.EmergencyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmergencyServlet</servlet-name>
        <url-pattern>/emergency/create</url-pattern>
        <url-pattern>/emergency/status</url-pattern>
        <url-pattern>/emergency/cancel</url-pattern>
    </servlet-mapping>

</web-app>
